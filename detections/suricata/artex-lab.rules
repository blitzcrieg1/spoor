# Lab segment rules — traffic to/from the Juice Shop target.
# Deploy with Suricata: suricata -S artex-lab.rules -i <iface>
# Traffic mirroring on Windows: see ../README.md (WSL2 / VM tap only).

# ARTEX/agent fingerprint: prober User-Agents referenced by the ARTEX repo's
# own detection material (norma SDK WebFetch / enrich prober).
alert http $HOME_NET any -> $HOME_NET any (msg:"LAB ARTEX fingerprint - norma/enrich User-Agent"; http.user_agent; content:"norma"; nocase; sid:9000001; rev:1;)
alert http $HOME_NET any -> $HOME_NET any (msg:"LAB ARTEX fingerprint - agent prober User-Agent"; http.user_agent; content:"python-requests"; content:"artex"; nocase; sid:9000002; rev:1;)

# Juice Shop exploitation attempts (SQLi / XSS / path traversal).
alert http any any -> $HOME_NET any (msg:"LAB SQLi probe against lab target"; http.uri|url_decode; content:"' OR "; nocase; sid:9000010; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB SQLi probe - UNION SELECT"; http.uri|url_decode; content:"UNION SELECT"; nocase; sid:9000011; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB XSS probe in request URI"; http.uri|url_decode; content:"<script"; nocase; sid:9000012; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB Path traversal attempt"; http.uri|url_decode; content:"../"; sid:9000013; rev:1;)

# Scanner User-Agents.
alert http any any -> $HOME_NET any (msg:"LAB sqlmap User-Agent"; http.user_agent; content:"sqlmap"; nocase; sid:9000020; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB nikto User-Agent"; http.user_agent; content:"nikto"; nocase; sid:9000021; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB nmap NSE / scripted probe"; http.user_agent; content:"nmap"; nocase; sid:9000022; rev:1;)

# Volume signal: a burst of 404s from one client (content discovery / fuzzing).
alert http any any -> $HOME_NET any (msg:"LAB burst of 404s from one client (fuzzing)"; http.stat_code; content:"404"; threshold: type both, track by_src, count 30, seconds 10; sid:9000030; rev:1;)

# Outbound egress attempts from the target network (labnet is internal; this
# catches bridges/leaks from a misconfigured stack).
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB target network egress to internet (should be blocked)"; sid:9000040; rev:1;)

# --- ThreatDefence ARTEX indicators (adapted; see docs/threatdefence-integration.md) ---
alert http any any -> $HOME_NET any (msg:"LAB ARTEX UA - api-recon spider"; http.user_agent; content:"spa-api-recon"; nocase; sid:9000101; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB ARTEX probe marker ARTEX_WRITE_PROBE"; http.uri; content:"ARTEX_WRITE_PROBE"; nocase; sid:9000102; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB ARTEX placeholder probe path"; http.uri; content:"zzz-nonexistent-xyz123"; nocase; sid:9000103; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB alg:none JWT prefix in request"; http.uri; content:"eyJhbGciOiJub25lIn0."; sid:9000104; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB ARTEX OAuth callback probe"; http.uri; content:"callback?code=AAAA&state=notvalidb64"; nocase; sid:9000105; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB ARTEX X-ARTX-KEY request header"; http.header_names; content:"X-ARTX-KEY"; nocase; sid:9000106; rev:1;)
